{
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python -m compileall app",
  "devCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ]
}
